# Copia este archivo como .env (no se sube al repositorio) y completa los valores.
# Lo usa docker-compose.yml (los dos microservicios: frontend y backend).

# Base de datos PostgreSQL. Si se deja vacío, el backend usa el PostgreSQL de esta computadora
# (base fundacion_jaguares_docker). Para la nube, pega la cadena del proveedor, por ejemplo:
# DB_CONEXION=Host=ep-xxxx.sa-east-1.aws.neon.tech;Port=5432;Database=jaguares;Username=usuario;Password=clave;SSL Mode=Require
DB_CONEXION=

# Genera uno con:  openssl rand -base64 48
JWT_SECRET=

# Puertos y direcciones de cada microservicio
PUERTO_BACKEND=8080
PUERTO_FRONTEND=3000
URL_BACKEND=http://localhost:8080
URL_FRONTEND=http://localhost:3000

# Correo (vacío = los correos solo se escriben en el log del backend)
# Gmail: smtp.gmail.com, puerto 587, usuario = la cuenta y clave = una contraseña de aplicación
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=no-responder@jaguares.org.bo
SMTP_SSL=true
CONTACTO_DESTINO=
