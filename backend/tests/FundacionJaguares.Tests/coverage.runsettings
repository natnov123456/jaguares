<?xml version="1.0" encoding="utf-8"?>
<!-- Cobertura (RNF-05): solo el código del backend, sin el proyecto de pruebas -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[FundacionJaguares.Api]*,[FundacionJaguares.Application]*,[FundacionJaguares.Domain]*,[FundacionJaguares.Infrastructure]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
