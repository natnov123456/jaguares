# JAG-77: copia este archivo como deploy/.env en el servidor y completa los valores.
# NUNCA subas el .env real al repositorio (está en .gitignore).

# Dominio oficial de la Fundación (debe apuntar con un registro A/AAAA a la IP del servidor)
DOMINIO=jaguares.org.bo
CORREO_LETSENCRYPT=sistemas@jaguares.org.bo

# Imágenes publicadas por el pipeline (GitHub Container Registry)
IMAGEN_API=ghcr.io/natnov123456/jaguares-api:latest
IMAGEN_WEB=ghcr.io/natnov123456/jaguares-web:latest

# Base de datos
POSTGRES_DB=fundacion_jaguares
POSTGRES_USER=jaguares
POSTGRES_PASSWORD=cambia-esta-clave-larga-y-aleatoria

# Seguridad: genera el secreto con   openssl rand -base64 48
JWT_SECRET=

# Correo (SMTP) para confirmaciones, recordatorios y comprobantes
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=no-responder@jaguares.org.bo
CONTACTO_DESTINO=contacto@jaguares.org.bo

# Pasarela de pago (si se contrata una); vacío = modo simulado
PASARELA_CLAVE=

# Respaldos
DIAS_RETENCION=30
